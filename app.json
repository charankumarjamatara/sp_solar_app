{
  "expo": {
    "name": "SP Solar Solutions",
    "slug": "sp-solar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "spsolar",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spsolar.customer",
      "infoPlist": {
        "NSCameraUsageDescription": "SP Solar Solutions needs access to your camera to photograph solar equipment and maintenance issues.",
        "NSPhotoLibraryUsageDescription": "SP Solar Solutions needs access to your photo library to upload pictures of your solar setup and issue logs."
      }
    },
    "android": {
      "package": "com.spsolar.customer",
      "adaptiveIcon": {
        "backgroundColor": "#001735",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#001735",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SP Solar Solutions needs access to your photo library to attach photos to support tickets.",
          "cameraPermission": "SP Solar Solutions needs access to your camera to take photos of solar maintenance issues."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a7a9eb49-2810-47f1-ac54-6807d836ae42"
      }
    }
  }
}
