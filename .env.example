# ==============================================================================
# SP Solar Solutions Customer Mobile Application - Environment Configuration
# ==============================================================================
# NOTE: All variables prefixed with EXPO_PUBLIC_ are bundled into client code.
# NEVER place private database credentials, secret keys, or JWT private keys here!
# ==============================================================================

# Backend Base URL (Leave empty or set EXPO_PUBLIC_USE_MOCK=true to use in-memory Mock Mode)
EXPO_PUBLIC_API_BASE_URL=https://api.spsolar.example.com/api/v1

# Legacy alias (also supported by client)
EXPO_PUBLIC_API_URL=https://api.spsolar.example.com/api/v1

# API vs Mock Switch: true (default) | false
# When set to true, in-memory mock services handle auth, tickets, and feedback.
# When set to false, real HTTP calls are made to EXPO_PUBLIC_API_BASE_URL.
EXPO_PUBLIC_USE_MOCK=true

# Environment: development | staging | production
EXPO_PUBLIC_APP_ENV=development

# API Request Timeout (milliseconds)
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# Support contact information placeholders
EXPO_PUBLIC_SUPPORT_PHONE=+91 98765 43210
EXPO_PUBLIC_SUPPORT_EMAIL=support@spsolar.example.com
